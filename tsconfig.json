{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "preact",
    "types": ["@cloudflare/workers-types", "vitest/globals"],
    "paths": {
      "~/*": ["./src/*"]
    }
  },
  "include": ["src/**/*", "test/**/*", "worker/**/*"],
  "exclude": ["dist", ".astro", ".wrangler", "node_modules"]
}
