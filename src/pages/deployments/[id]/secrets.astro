---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { SecretsEditor } from '../../../components/SecretsEditor';
const id = parseInt(Astro.params.id ?? '0', 10);
---
<BaseLayout title={`Secrets — Deployment ${id}`}>
  <p style="margin-bottom: var(--space-3)">
    <a href={`/deployments/${id}`}>← Back to deployment</a>
  </p>
  <SecretsEditor id={id} client:only="preact" />
</BaseLayout>